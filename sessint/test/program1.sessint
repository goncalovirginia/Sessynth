stype IntCStream rec x. &{next: int^x, stop: @};
fib : int -> int -> {IntCStream}
fun n acc -> c <- {
    case c of
        next: (
            send c n;
            d <- spawn (fib acc (n + acc));
            fwd d c
        )
        stop: (
            close c
        )
} end;
;;
m <- {
    f <- spawn (fib 0 1);
    f.next;
    x1:int <- recv f;
    print x1;
    f.next;
    x2:int <- recv f;
    print x2;
    f.next;
    x3:int <- recv f;
    print x3;
    f.stop;
    wait f;
    close m
}
;;