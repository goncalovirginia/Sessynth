0:
_c0 <- {
  case _c0 of
  ask:
    t.ask;
    _x0 <- recv t;
    send _c0 _x0;
    fwd t _c0
  bye:
    t.bye;
    wait t;
    close _c0
} <- [t:𝜇1 x. &{ask:int ∧ x, bye:1}]

1:
_c0 <- {
  case _c0 of
  ask:
    t.ask;
    _x0 <- recv t;
    send _c0 _x0;
    _c1 <- spawn echo [t];
    fwd _c1 _c0
  bye:
    t.bye;
    wait t;
    close _c0
} <- [t:𝜇1 x. &{ask:int ∧ x, bye:1}]

2:
_c0 <- {
  case _c0 of
  ask:
    t.ask;
    _x0 <- recv t;
    send _c0 _x0;
    _c1 <- spawn echo [t];
    _c2 <- spawn echo [_c1];
    fwd _c2 _c0
  bye:
    t.bye;
    wait t;
    close _c0
} <- [t:𝜇1 x. &{ask:int ∧ x, bye:1}]
