0:
_c0 <- {
  _x0 <- recv u;
  _x1 <- recv t;
  send _c0 _x1;
  _c1 <- spawn two [t; u];
  fwd _c1 _c0
} <- [u:𝜇1 x. int ∧ x, t:𝜇1 x. int ∧ x]

