0:
_c0 <- {
  _x0 <- recv t;
  send _c0 _x0;
  fwd t _c0
} <- [t:𝜇1 x. int ∧ x]

1:
_c0 <- {
  _x0 <- recv t;
  send _c0 _x0;
  _c1 <- spawn dup [t];
  fwd _c1 _c0
} <- [t:𝜇1 x. int ∧ x]

2:
_c0 <- {
  _x0 <- recv t;
  send _c0 _x0;
  _c1 <- spawn dup [t];
  _c2 <- spawn dup [_c1];
  fwd _c2 _c0
} <- [t:𝜇1 x. int ∧ x]

3:
_c0 <- {
  _x0 <- recv t;
  send _c0 1;
  fwd t _c0
} <- [t:𝜇1 x. int ∧ x]
